# Valeurs de demonstration locale uniquement. Copier vers .env.
POSTGRES_DB=releasepilot
POSTGRES_USER=releasepilot
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# Demonstration seulement : remplacer par 32 octets aleatoires encodes en Base64.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_EXPIRATION_SECONDS=900

# Cache d'evaluation uniquement ; PostgreSQL reste la source de verite.
EVALUATION_CACHE_TTL_SECONDS=60

# Exact dashboard origin allowed by CORS (no trailing slash, no cookies).
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Full Docker demo; distinct from development ports 8080/5173/5174.
DOCKER_BACKEND_PORT=18080
DOCKER_DASHBOARD_PORT=15173
DOCKER_DEMO_PORT=15174
